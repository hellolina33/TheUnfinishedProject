{"v":[{"a":["وَٱلۡمُرۡسَلَٰتِ","عُرۡفٗا"],"t":"By those unleashed in succession","l":"Wa Al-Mursalati `Urfaan","w":[["wal-mur'salāti","By the ones sent forth"],["ʿur'fan","one after another"]]},{"a":["فَٱلۡعَٰصِفَٰتِ","عَصۡفٗا"],"t":"Storming turbulently","l":"Fal`asifati `Asfaan","w":[["fal-ʿāṣifāti","And the winds that blow"],["ʿaṣfan","violently"]]},{"a":["وَٱلنَّـٰشِرَٰتِ","نَشۡرٗا"],"t":"Scattering far and wide","l":"Wa An-Nashirati Nashraan","w":[["wal-nāshirāti","And the ones that scatter"],["nashran","far and wide"]]},{"a":["فَٱلۡفَٰرِقَٰتِ","فَرۡقٗا"],"t":"Separating decisively","l":"Falfariqati Farqaan","w":[["fal-fāriqāti","And those who separate"],["farqan","(by the) Criterion"]]},{"a":["فَٱلۡمُلۡقِيَٰتِ","ذِكۡرًا"],"t":"Delivering a message","l":"Falmulqiyati Dhikraan","w":[["fal-mul'qiyāti","And those who bring down"],["dhik'ran","(the) Reminder"]]},{"a":["عُذۡرًا","أَوۡ","نُذۡرًا"],"t":"Excusing or warning","l":"Udhraan 'Aw Nudhraan","w":[["ʿudh'ran","(As) justification"],["aw","or"],["nudh'ran","warning"]]},{"a":["إِنَّمَا","تُوعَدُونَ","لَوَٰقِعٞ"],"t":"Surely what you are promised will happen","l":"Innama Tu`aduna Lawaqi`un","w":[["innamā","Indeed, what"],["tūʿadūna","you are promised"],["lawāqiʿun","will surely occur"]]},{"a":["فَإِذَا","ٱلنُّجُومُ","طُمِسَتۡ"],"t":"When the stars are obliterated","l":"Fa'idha An-Nujumu Tumisat","w":[["fa-idhā","So when"],["l-nujūmu","the stars"],["ṭumisat","are obliterated"]]},{"a":["وَإِذَا","ٱلسَّمَآءُ","فُرِجَتۡ"],"t":"And the sky is fractured","l":"Wa 'Idha As-Sama'u Furijat","w":[["wa-idhā","And when"],["l-samāu","the heaven"],["furijat","is cleft asunder"]]},{"a":["وَإِذَا","ٱلۡجِبَالُ","نُسِفَتۡ"],"t":"And the mountains are blown away","l":"Wa 'Idha Al-Jibalu Nusifat","w":[["wa-idhā","And when"],["l-jibālu","the mountains"],["nusifat","are blown away"]]},{"a":["وَإِذَا","ٱلرُّسُلُ","أُقِّتَتۡ"],"t":"And the messengers are alerted","l":"Wa 'Idha Ar-Rusulu 'Uqqitat","w":[["wa-idhā","And when"],["l-rusulu","the Messengers"],["uqqitat","are gathered to their appointed time"]]},{"a":["لِأَيِّ","يَوۡمٍ","أُجِّلَتۡ"],"t":"Until which day is it deferred","l":"L'ayyi Yawmin 'Ujjilat","w":[["li-ayyi","For what"],["yawmin","Day"],["ujjilat","are (these) postponed"]]},{"a":["لِيَوۡمِ","ٱلۡفَصۡلِ"],"t":"Until the Day of Decision","l":"Liyawmi Al-Fasli","w":[["liyawmi","For (the) Day"],["l-faṣli","(of) Judgment"]]},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","يَوۡمُ","ٱلۡفَصۡلِ"],"t":"And what will teach you what the Day of Decision is","l":"Wa Ma 'Adraka Ma Yawmu Al-Fasli","w":[["wamā","And what"],["adrāka","will make you know"],["mā","what"],["yawmu","(is the) Day"],["l-faṣli","(of) the Judgment"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the liars","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["أَلَمۡ","نُهۡلِكِ","ٱلۡأَوَّلِينَ"],"t":"Did We not destroy the ancients","l":"Alam Nuhliki Al-'Awwalina","w":[["alam","Did not"],["nuh'liki","We destroy"],["l-awalīna","the former (people)"]]},{"a":["ثُمَّ","نُتۡبِعُهُمُ","ٱلۡأٓخِرِينَ"],"t":"Then succeeded them with the others","l":"Thumma Nutbi`uhumu Al-'Akhirina","w":[["thumma","Then"],["nut'biʿuhumu","We follow them up"],["l-ākhirīna","(with) the later ones"]]},{"a":["كَذَٰلِكَ","نَفۡعَلُ","بِٱلۡمُجۡرِمِينَ"],"t":"This is how We deal with the guilty","l":"Kadhalika Naf`alu Bil-Mujrimina","w":[["kadhālika","Thus"],["nafʿalu","We deal"],["bil-muj'rimīna","with the criminals"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the rejecters","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["أَلَمۡ","نَخۡلُقكُّم","مِّن","مَّآءٖ","مَّهِينٖ"],"t":"Did We not create you from an insignificant fluid","l":"Alam Nakhluqkum Min Ma'in Mahinin","w":[["alam","Did not"],["nakhluqkkum","We create you"],["min","from"],["māin","a water"],["mahīnin","despicable"]]},{"a":["فَجَعَلۡنَٰهُ","فِي","قَرَارٖ","مَّكِينٍ"],"t":"Then lodged it in a secure place","l":"Faja`alnahu Fi Qararin Makinin","w":[["fajaʿalnāhu","Then We placed it"],["fī","in"],["qarārin","an abode"],["makīnin","safe"]]},{"a":["إِلَىٰ","قَدَرٖ","مَّعۡلُومٖ"],"t":"For a known term","l":"Ila Qadarin Ma`lumin","w":[["ilā","For"],["qadarin","a period"],["maʿlūmin","known"]]},{"a":["فَقَدَرۡنَا","فَنِعۡمَ","ٱلۡقَٰدِرُونَ"],"t":"We measured precisely. We are the best to measure","l":"Faqadarna Fani`ma Al-Qadiruna","w":[["faqadarnā","So We measured"],["faniʿ'ma","and Best"],["l-qādirūna","(are We to) measure"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the falsifiers","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["أَلَمۡ","نَجۡعَلِ","ٱلۡأَرۡضَ","كِفَاتًا"],"t":"Did We not make the earth a homestead","l":"Alam Naj`ali Al-'Arđa Kifataan","w":[["alam","Have not"],["najʿali","We made"],["l-arḍa","the earth"],["kifātan","a receptacle"]]},{"a":["أَحۡيَآءٗ","وَأَمۡوَٰتٗا"],"t":"For the living and the dead","l":"Ahya'an Wa 'Amwataan","w":[["aḥyāan","(For the) living"],["wa-amwātan","and (the) dead"]]},{"a":["وَجَعَلۡنَا","فِيهَا","رَوَٰسِيَ","شَٰمِخَٰتٖ","وَأَسۡقَيۡنَٰكُم","مَّآءٗ","فُرَاتٗا"],"t":"And set on it lofty mountains, and given you pure water to drink","l":"Wa Ja`alna Fiha Rawasiya Shamikhatin Wa 'Asqaynakum Ma'an Furataan","w":[["wajaʿalnā","And We made"],["fīhā","therein"],["rawāsiya","firmly set mountains"],["shāmikhātin","lofty"],["wa-asqaynākum","and We gave you to drink"],["māan","water "],["furātan","sweet"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the deniers","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["ٱنطَلِقُوٓاْ","إِلَىٰ","مَا","كُنتُم","بِهِۦ","تُكَذِّبُونَ"],"t":"“Proceed to what you used to deny.”","l":"Antaliqu 'Ila Ma Kuntum Bihi Tukadhibuna","w":[["inṭaliqū","Proceed"],["ilā","to"],["mā","what"],["kuntum","you used to"],["bihi","in it"],["tukadhibūna","deny"]]},{"a":["ٱنطَلِقُوٓاْ","إِلَىٰ","ظِلّٖ","ذِي","ثَلَٰثِ","شُعَبٖ"],"t":"“Proceed to a shadow of three different masses.”","l":"Antaliqu 'Ila Zillin Dhi Thalathi Shu`abin","w":[["inṭaliqū","Proceed"],["ilā","to"],["ẓillin","a shadow"],["dhī","having"],["thalāthi","three"],["shuʿabin","columns"]]},{"a":["لَّا","ظَلِيلٖ","وَلَا","يُغۡنِي","مِنَ","ٱللَّهَبِ"],"t":"Offering no shade, and unavailing against the flames","l":"La Zalilin Wa La Yughni Mina Al-Lahabi","w":[["lā","No"],["ẓalīlin","cool shade"],["walā","and not"],["yugh'nī","availing"],["mina","against"],["l-lahabi","the flame"]]},{"a":["إِنَّهَا","تَرۡمِي","بِشَرَرٖ","كَٱلۡقَصۡرِ"],"t":"It shoots sparks as castles","l":"Innaha Tarmi Bishararin Kalqasri","w":[["innahā","Indeed, it"],["tarmī","throws up"],["bishararin","sparks"],["kal-qaṣri","as the fortress"]]},{"a":["كَأَنَّهُۥ","جِمَٰلَتٞ","صُفۡرٞ"],"t":"As if they were yellow camels","l":"Ka'annahu Jimalatun Sufrun","w":[["ka-annahu","As if they (were)"],["jimālatun","camels"],["ṣuf'run","yellow"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the liars","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["هَٰذَا","يَوۡمُ","لَا","يَنطِقُونَ"],"t":"This is a Day when they will not speak","l":"Hadha Yawmu La Yantiquna","w":[["hādhā","This"],["yawmu","(is) a Day"],["lā","not"],["yanṭiqūna","they will speak"]]},{"a":["وَلَا","يُؤۡذَنُ","لَهُمۡ","فَيَعۡتَذِرُونَ"],"t":"And they will not be allowed to apologize","l":"Wa La Yu'udhanu Lahum Faya`tadhiruna","w":[["walā","And not"],["yu'dhanu","will it be permitted"],["lahum","for them"],["fayaʿtadhirūna","to make excuses"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the rejecters","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["هَٰذَا","يَوۡمُ","ٱلۡفَصۡلِۖ","جَمَعۡنَٰكُمۡ","وَٱلۡأَوَّلِينَ"],"t":"This is the Day of Separation; We have gathered you, together with the ancients","l":"Hadha Yawmu Al-Fasli Jama`nakum Wa Al-'Awwalina","w":[["hādhā","This"],["yawmu","(is the) Day"],["l-faṣli","(of) Judgment"],["jamaʿnākum","We have gathered you"],["wal-awalīna","and the former (people)"]]},{"a":["فَإِن","كَانَ","لَكُمۡ","كَيۡدٞ","فَكِيدُونِ"],"t":"So if you have a strategy, use it against Me","l":"Fa'in Kana Lakum Kaydun Fakiduni","w":[["fa-in","So if"],["kāna","is"],["lakum","for you"],["kaydun","a plan"],["fakīdūni","then plan against Me"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the falsifiers","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["إِنَّ","ٱلۡمُتَّقِينَ","فِي","ظِلَٰلٖ","وَعُيُونٖ"],"t":"The righteous will be amidst shades and fountains","l":"Inna Al-Muttaqina Fi Zilalin Wa `Uyunin","w":[["inna","Indeed"],["l-mutaqīna","the righteous"],["fī","(will be) in"],["ẓilālin","shades"],["waʿuyūnin","and springs"]]},{"a":["وَفَوَٰكِهَ","مِمَّا","يَشۡتَهُونَ"],"t":"And fruits as they desire","l":"Wa Fawakiha Mimma Yashtahuna","w":[["wafawākiha","And fruits"],["mimmā","from what"],["yashtahūna","they desire"]]},{"a":["كُلُواْ","وَٱشۡرَبُواْ","هَنِيٓـَٔۢا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"t":"“Eat and drink pleasantly, for what you used to do.”","l":"Kulu Wa Ashrabu Hani'aan Bima Kuntum Ta`maluna","w":[["kulū","Eat"],["wa-ish'rabū","and drink"],["hanīan","(in) satisfaction"],["bimā","for what"],["kuntum","you used to"],["taʿmalūna","do"]]},{"a":["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"t":"This is how We reward the doers of good","l":"Inna Kadhalika Najzi Al-Muhsinyna","w":[["innā","Indeed, We"],["kadhālika","thus"],["najzī","reward"],["l-muḥ'sinīna","the good-doers"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the deniers","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["كُلُواْ","وَتَمَتَّعُواْ","قَلِيلًا","إِنَّكُم","مُّجۡرِمُونَ"],"t":"“Eat and enjoy yourselves a little; you are indeed criminals.”","l":"Kulu Wa Tamatta`u Qalilaan 'Innakum Mujrimuna","w":[["kulū","Eat"],["watamattaʿū","and enjoy yourselves"],["qalīlan","a little"],["innakum","indeed, you"],["muj'rimūna","(are) criminals"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the liars","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["وَإِذَا","قِيلَ","لَهُمُ","ٱرۡكَعُواْ","لَا","يَرۡكَعُونَ"],"t":"And when it is said to them, “Kneel”, they do not kneel","l":"Wa 'Idha Qila Lahumu Arka`u La Yarka`una","w":[["wa-idhā","And when"],["qīla","it is said"],["lahumu","to them"],["ir'kaʿū","Bow"],["lā","not"],["yarkaʿūna","they bow"]]},{"a":["وَيۡلٞ","يَوۡمَئِذٖ","لِّلۡمُكَذِّبِينَ"],"t":"Woe on that Day to the rejecters","l":"Waylun Yawma'idhin Lilmukadhibina","w":[["waylun","Woe"],["yawma-idhin","that Day"],["lil'mukadhibīna","to the deniers"]]},{"a":["فَبِأَيِّ","حَدِيثِۭ","بَعۡدَهُۥ","يُؤۡمِنُونَ"],"t":"In what message, beyond this, will they believe","l":"Fabi'ayyi Hadithin Ba`dahu Yu'uminuna","w":[["fabi-ayyi","Then in what"],["ḥadīthin","statement"],["baʿdahu","after it"],["yu'minūna","will they believe"]]}]}