{"v":[{"a":["وَٱلسَّمَآءِ","وَٱلطَّارِقِ"],"t":"By the sky and at-Tariq","l":"Wa As-Sama'i Wa At-Tariqi","w":[["wal-samāi","By the sky"],["wal-ṭāriqi","and the night comer"]]},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلطَّارِقُ"],"t":"But what will let you know what at-Tariq is","l":"Wa Ma 'Adraka Ma At-Tariqu","w":[["wamā","And what"],["adrāka","can make you know"],["mā","what"],["l-ṭāriqu","the night comer (is)"]]},{"a":["ٱلنَّجۡمُ","ٱلثَّاقِبُ"],"t":"The Piercing Star","l":"An-Najmu Ath-Thaqibu","w":[["al-najmu","(It is) the star"],["l-thāqibu","the piercing"]]},{"a":["إِن","كُلُّ","نَفۡسٖ","لَّمَّا","عَلَيۡهَا","حَافِظٞ"],"t":"There is no soul without a Protector over it","l":"In Kullu Nafsin Lamma `Alayha Hafizun","w":[["in","Not"],["kullu","(is) every"],["nafsin","soul"],["lammā","but"],["ʿalayhā","over it"],["ḥāfiẓun","(is) a protector"]]},{"a":["فَلۡيَنظُرِ","ٱلۡإِنسَٰنُ","مِمَّ","خُلِقَ"],"t":"Let man consider what he was created from","l":"Falyanzuri Al-'Insanu Mimma Khuliqa","w":[["falyanẓuri","So let see"],["l-insānu","man"],["mimma","from what"],["khuliqa","he is created"]]},{"a":["خُلِقَ","مِن","مَّآءٖ","دَافِقٖ"],"t":"He was created from gushing liquid","l":"Khuliqa Min Ma'in Dafiqin","w":[["khuliqa","He is created"],["min","from"],["māin","a water"],["dāfiqin","ejected"]]},{"a":["يَخۡرُجُ","مِنۢ","بَيۡنِ","ٱلصُّلۡبِ","وَٱلتَّرَآئِبِ"],"t":"Issuing from between the backbone and the breastbones","l":"Yakhruju Min Bayni As-Sulbi Wa At-Tara'ibi","w":[["yakhruju","Coming forth"],["min","from"],["bayni","between"],["l-ṣul'bi","the backbone"],["wal-tarāibi","and the ribs"]]},{"a":["إِنَّهُۥ","عَلَىٰ","رَجۡعِهِۦ","لَقَادِرٞ"],"t":"He is certainly able to return him","l":"Innahu `Ala Raj`ihi Laqadirun","w":[["innahu","Indeed, He"],["ʿalā","to"],["rajʿihi","return him"],["laqādirun","(is) Able"]]},{"a":["يَوۡمَ","تُبۡلَى","ٱلسَّرَآئِرُ"],"t":"On the Day when the secrets are disclosed","l":"Yawma Tubla As-Sara'iru","w":[["yawma","(The) Day"],["tub'lā","will be tested"],["l-sarāiru","the secrets"]]},{"a":["فَمَا","لَهُۥ","مِن","قُوَّةٖ","وَلَا","نَاصِرٖ"],"t":"He will have no strength, and no supporter","l":"Fama Lahu Min Quwatin Wa La Nasirin","w":[["famā","Then not"],["lahu","(is) for him"],["min","any"],["quwwatin","power"],["walā","and not"],["nāṣirin","any helper"]]},{"a":["وَٱلسَّمَآءِ","ذَاتِ","ٱلرَّجۡعِ"],"t":"By the sky that returns","l":"Wa As-Sama'i Dhati Ar-Raj`i","w":[["wal-samāi","By the sky"],["dhāti","which"],["l-rajʿi","returns"]]},{"a":["وَٱلۡأَرۡضِ","ذَاتِ","ٱلصَّدۡعِ"],"t":"And the earth that cracks open","l":"Wa Al-'Arđi Dhati As-Sad`i","w":[["wal-arḍi","And the earth"],["dhāti","which"],["l-ṣadʿi","cracks open"]]},{"a":["إِنَّهُۥ","لَقَوۡلٞ","فَصۡلٞ"],"t":"It is a Decisive Word","l":"Innahu Laqawlun Faslun","w":[["innahu","Indeed, it"],["laqawlun","(is) surely a Word"],["faṣlun","decisive"]]},{"a":["وَمَا","هُوَ","بِٱلۡهَزۡلِ"],"t":"It is no joke","l":"Wa Ma Huwa Bil-Hazli","w":[["wamā","And not"],["huwa","it"],["bil-hazli","(is) for amusement"]]},{"a":["إِنَّهُمۡ","يَكِيدُونَ","كَيۡدٗا"],"t":"They plot and scheme","l":"Innahum Yakiduna Kaydaan","w":[["innahum","Indeed, they"],["yakīdūna","are plotting"],["kaydan","a plot"]]},{"a":["وَأَكِيدُ","كَيۡدٗا"],"t":"But I plot and scheme","l":"Wa 'Akidu Kaydaan","w":[["wa-akīdu","But I am planning"],["kaydan","a plan"]]},{"a":["فَمَهِّلِ","ٱلۡكَٰفِرِينَ","أَمۡهِلۡهُمۡ","رُوَيۡدَۢا"],"t":"Therefore, give the blasphemers respite, a brief respite","l":"Famahhili Al-Kafirina 'Amhilhum Ruwaydaan","w":[["famahhili","So give respite"],["l-kāfirīna","(to) the disbelievers"],["amhil'hum","Give respite to them "],["ruwaydan","little"]]}]}