{"v":[{"a":["وَٱلنَّـٰزِعَٰتِ","غَرۡقٗا"],"t":"By those who snatch violently","l":"Wa An-Nazi`ati Gharqaan","w":[["wal-nāziʿāti","By those who extract"],["gharqan","violently"]]},{"a":["وَٱلنَّـٰشِطَٰتِ","نَشۡطٗا"],"t":"And those who remove gently","l":"Wa An-Nashitati Nashtaan","w":[["wal-nāshiṭāti","And those who draw out"],["nashṭan","gently"]]},{"a":["وَٱلسَّـٰبِحَٰتِ","سَبۡحٗا"],"t":"And those who glide smoothly","l":"Wa As-Sabihati Sabhaan","w":[["wal-sābiḥāti","And those who glide"],["sabḥan","swimming"]]},{"a":["فَٱلسَّـٰبِقَٰتِ","سَبۡقٗا"],"t":"And those who race swiftly","l":"Falssabiqati Sabqaan","w":[["fal-sābiqāti","And those who race each other"],["sabqan","(in) a race"]]},{"a":["فَٱلۡمُدَبِّرَٰتِ","أَمۡرٗا"],"t":"And those who regulate events","l":"Falmudabbirati 'Amraan","w":[["fal-mudabirāti","And those who arrange"],["amran","(the) matter"]]},{"a":["يَوۡمَ","تَرۡجُفُ","ٱلرَّاجِفَةُ"],"t":"On the Day when the Quake quakes","l":"Yawma Tarjufu Ar-Rajifahu","w":[["yawma","(The) Day"],["tarjufu","will quake"],["l-rājifatu","the quaking one"]]},{"a":["تَتۡبَعُهَا","ٱلرَّادِفَةُ"],"t":"And is followed by the Successor","l":"Tatba`uha Ar-Radifahu","w":[["tatbaʿuhā","Follows it"],["l-rādifatu","the subsequent"]]},{"a":["قُلُوبٞ","يَوۡمَئِذٖ","وَاجِفَةٌ"],"t":"Hearts on that Day will be pounding","l":"Qulubun Yawma'idhin Wajifahun","w":[["qulūbun","Hearts"],["yawma-idhin","that Day"],["wājifatun","will palpitate"]]},{"a":["أَبۡصَٰرُهَا","خَٰشِعَةٞ"],"t":"Their sights downcast","l":"Absaruha Khashi`ahun","w":[["abṣāruhā","Their eyes"],["khāshiʿatun","humbled"]]},{"a":["يَقُولُونَ","أَءِنَّا","لَمَرۡدُودُونَ","فِي","ٱلۡحَافِرَةِ"],"t":"They say, “Are we to be restored to the original condition","l":"Yaquluna 'A'inna Lamarduduna Fi Al-Hafirahi","w":[["yaqūlūna","They say"],["a-innā","Will we"],["lamardūdūna","indeed be returned"],["fī","to"],["l-ḥāfirati","the former state"]]},{"a":["أَءِذَا","كُنَّا","عِظَٰمٗا","نَّخِرَةٗ"],"t":"When we have become hollow bone