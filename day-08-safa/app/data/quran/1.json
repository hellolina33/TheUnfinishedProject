{"v":[{"a":["بِسۡمِ","ٱللَّهِ","ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"t":"In the name of God, the Gracious, the Merciful","l":"Bismi Allahi Ar-Rahmani Ar-Rahimi","w":[["bis'mi","In (the) name"],["l-lahi","(of) Allah"],["l-raḥmāni","the Most Gracious"],["l-raḥīmi","the Most Merciful"]]},{"a":["ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"t":"Praise be to God, Lord of the Worlds","l":"Al-Hamdu Lillahi Rabbi Al-`Alamina","w":[["al-ḥamdu","All praises and thanks"],["lillahi","(be) to Allah"],["rabbi","the Lord"],["l-ʿālamīna","of the universe"]]},{"a":["ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"t":"The Most Gracious, the Most Merciful","l":"Ar-Rahmani Ar-Rahimi","w":[["al-raḥmāni","The Most Gracious"],["l-raḥīmi","the Most Merciful"]]},{"a":["مَٰلِكِ","يَوۡمِ","ٱلدِّينِ"],"t":"Master of the Day of Judgment","l":"Maliki Yawmi Ad-Dini","w":[["māliki","(The) Master"],["yawmi","(of the) Day"],["l-dīni","(of the) Judgment"]]},{"a":["إِيَّاكَ","نَعۡبُدُ","وَإِيَّاكَ","نَسۡتَعِينُ"],"t":"It is You we worship, and upon You we call for help","l":"Iyaka Na`budu Wa 'Iyaka Nasta`inu","w":[["iyyāka","You Alone"],["naʿbudu","we worship"],["wa-iyyāka","and You Alone"],["nastaʿīnu","we ask for help"]]},{"a":["ٱهۡدِنَا","ٱلصِّرَٰطَ","ٱلۡمُسۡتَقِيمَ"],"t":"Guide us to the straight path","l":"Ihdina As-Sirata Al-Mustaqima","w":[["ih'dinā","Guide us"],["l-ṣirāṭa","(to) the path"],["l-mus'taqīma","the straight"]]},{"a":["صِرَٰطَ","ٱلَّذِينَ","أَنۡعَمۡتَ","عَلَيۡهِمۡ","غَيۡرِ","ٱلۡمَغۡضُوبِ","عَلَيۡهِمۡ","وَلَا","ٱلضَّآلِّينَ"],"t":"The path of those You have blessed, not of those against whom there is anger, nor of those who are misguided","l":"Sirata Al-Ladhina 'An`amta `Alayhim Ghayri Al-Maghđubi `Alayhim Wa La Ađ-Đallina","w":[["ṣirāṭa","(The) path"],["alladhīna","(of) those"],["anʿamta","You have bestowed (Your) Favors"],["ʿalayhim","on them"],["ghayri","not (of)"],["l-maghḍūbi","those who earned (Your) wrath"],["ʿalayhim","on themselves"],["walā","and not"],["l-ḍālīna","(of) those who go astray"]]}]}