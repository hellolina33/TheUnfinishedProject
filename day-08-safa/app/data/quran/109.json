{"v":[{"a":["قُلۡ","يَـٰٓأَيُّهَا","ٱلۡكَٰفِرُونَ"],"t":"Say, “O disbelievers","l":"Qul Ya 'Ayyuha Al-Kafiruna","w":[["qul","Say"],["yāayyuhā","O"],["l-kāfirūna","disbelievers"]]},{"a":["لَآ","أَعۡبُدُ","مَا","تَعۡبُدُونَ"],"t":"I do not worship what you worship","l":"La 'A`budu Ma Ta`buduna","w":[["lā","Not"],["aʿbudu","I worship"],["mā","what"],["taʿbudūna","you worship"]]},{"a":["وَلَآ","أَنتُمۡ","عَٰبِدُونَ","مَآ","أَعۡبُدُ"],"t":"Nor do you worship what I worship","l":"Wa La 'Antum `Abiduna Ma 'A`budu","w":[["walā","And not"],["antum","you"],["ʿābidūna","(are) worshippers"],["mā","(of) what"],["aʿbudu","I worship"]]},{"a":["وَلَآ","أَنَا۠","عَابِدٞ","مَّا","عَبَدتُّمۡ"],"t":"Nor do I serve what you serve","l":"Wa La 'Ana `Abidun Ma `Abadttum","w":[["walā","And not"],["anā","I am"],["ʿābidun","a worshipper"],["mā","(of) what"],["ʿabadttum","you worship"]]},{"a":["وَلَآ","أَنتُمۡ","عَٰبِدُونَ","مَآ","أَعۡبُدُ"],"t":"Nor do you serve what I serve","l":"Wa La 'Antum `Abiduna Ma 'A`budu","w":[["walā","And not"],["antum","you"],["ʿābidūna","(are) worshippers"],["mā","(of) what"],["aʿbudu","I worship"]]},{"a":["لَكُمۡ","دِينُكُمۡ","وَلِيَ","دِينِ"],"t":"You have your way, and I have my way.”","l":"Lakum Dinukum Wa Liya Dini","w":[["lakum","For you"],["dīnukum","(is) your religion"],["waliya","and for me"],["dīni","(is) my religion"]]}]}