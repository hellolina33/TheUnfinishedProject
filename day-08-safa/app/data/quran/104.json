{"v":[{"a":["وَيۡلٞ","لِّكُلِّ","هُمَزَةٖ","لُّمَزَةٍ"],"t":"Woe to every slanderer backbiter","l":"Waylun Likulli Humazatin Lumazahin","w":[["waylun","Woe"],["likulli","to every"],["humazatin","slanderer"],["lumazatin","backbiter"]]},{"a":["ٱلَّذِي","جَمَعَ","مَالٗا","وَعَدَّدَهُۥ"],"t":"Who gathers wealth and counts it over","l":"Al-Ladhi Jama`a Malaan Wa `Addadahu","w":[["alladhī","The one who"],["jamaʿa","collects"],["mālan","wealth"],["waʿaddadahu","and counts it"]]},{"a":["يَحۡسَبُ","أَنَّ","مَالَهُۥٓ","أَخۡلَدَهُۥ"],"t":"Thinking that his wealth has made him immortal","l":"Yahsabu 'Anna Malahu 'Akhladahu","w":[["yaḥsabu","Thinking"],["anna","that"],["mālahu","his wealth"],["akhladahu","will make him immortal"]]},{"a":["كَلَّاۖ","لَيُنۢبَذَنَّ","فِي","ٱلۡحُطَمَةِ"],"t":"By no means. He will be thrown into the Crusher","l":"Kalla Layunbadhanna Fi Al-Hutamahi","w":[["kallā","Nay"],["layunbadhanna","Surely he will be thrown"],["fī","in"],["l-ḥuṭamati","the Crusher"]]},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡحُطَمَةُ"],"t":"And what will make you realize what the Crusher is","l":"Wa Ma 'Adraka Ma Al-Hutamahu","w":[["wamā","And what"],["adrāka","will make you know"],["mā","what"],["l-ḥuṭamatu","the Crusher (is)"]]},{"a":["نَارُ","ٱللَّهِ","ٱلۡمُوقَدَةُ"],"t":"God's kindled Fire","l":"Naru Allahi Al-Muqadahu","w":[["nāru","A Fire"],["l-lahi","Allah"],["l-mūqadatu","kindled"]]},{"a":["ٱلَّتِي","تَطَّلِعُ","عَلَى","ٱلۡأَفۡـِٔدَةِ"],"t":"That laps to the hearts","l":"Allati Tattali`u `Ala Al-'Af'idahi","w":[["allatī","Which"],["taṭṭaliʿu","mounts up"],["ʿalā","to"],["l-afidati","the hearts"]]},{"a":["إِنَّهَا","عَلَيۡهِم","مُّؤۡصَدَةٞ"],"t":"It closes in on them","l":"Innaha `Alayhim Mu'usadahun","w":[["innahā","Indeed, it"],["ʿalayhim","(will be) upon them"],["mu'ṣadatun","closed over"]]},{"a":["فِي","عَمَدٖ","مُّمَدَّدَةِۭ"],"t":"In extended columns","l":"Fi `Amadin Mumaddadahin","w":[["fī","In"],["ʿamadin","columns"],["mumaddadatin","extended"]]}]}