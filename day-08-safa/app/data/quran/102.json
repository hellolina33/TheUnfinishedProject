{"v":[{"a":["أَلۡهَىٰكُمُ","ٱلتَّكَاثُرُ"],"t":"Abundance distracts you","l":"Alhakumu At-Takathuru","w":[["alhākumu","Diverts you"],["l-takāthuru","the competition to increase"]]},{"a":["حَتَّىٰ","زُرۡتُمُ","ٱلۡمَقَابِرَ"],"t":"Until you visit the graveyards","l":"Hatta Zurtumu Al-Maqabira","w":[["ḥattā","Until"],["zur'tumu","you visit"],["l-maqābira","the graves"]]},{"a":["كَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"t":"Indeed, you will know","l":"Kalla Sawfa Ta`lamuna","w":[["kallā","Nay"],["sawfa","Soon"],["taʿlamūna","you will know"]]},{"a":["ثُمَّ","كَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"t":"Certainly, you will know","l":"Thumma Kalla Sawfa Ta`lamuna","w":[["thumma","Then"],["kallā","nay"],["sawfa","Soon"],["taʿlamūna","you will know"]]},{"a":["كَلَّا","لَوۡ","تَعۡلَمُونَ","عِلۡمَ","ٱلۡيَقِينِ"],"t":"If you knew with knowledge of certainty","l":"Kalla Law Ta`lamuna `Ilma Al-Yaqini","w":[["kallā","Nay"],["law","If"],["taʿlamūna","you know"],["ʿil'ma","(with) a knowledge"],["l-yaqīni","(of) certainty"]]},{"a":["لَتَرَوُنَّ","ٱلۡجَحِيمَ"],"t":"You would see the Inferno","l":"Latarawunna Al-Jahima","w":[["latarawunna","Surely you will see"],["l-jaḥīma","the Hellfire"]]},{"a":["ثُمَّ","لَتَرَوُنَّهَا","عَيۡنَ","ٱلۡيَقِينِ"],"t":"Then you will see it with the eye of certainty","l":"Thumma Latarawunnaha `Ayna Al-Yaqini","w":[["thumma","Then"],["latarawunnahā","surely you will see it"],["ʿayna","(with the) eye"],["l-yaqīni","(of) certainty"]]},{"a":["ثُمَّ","لَتُسۡـَٔلُنَّ","يَوۡمَئِذٍ","عَنِ","ٱلنَّعِيمِ"],"t":"Then, on that Day, you will be questioned about the Bliss","l":"Thumma Latus'alunna Yawma'idhin `Ani An-Na`imi","w":[["thumma","Then"],["latus'alunna","surely you will be asked"],["yawma-idhin","that Day"],["ʿani","about"],["l-naʿīmi","the pleasures"]]}]}