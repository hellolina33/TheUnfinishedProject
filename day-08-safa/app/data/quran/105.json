{"v":[{"a":["أَلَمۡ","تَرَ","كَيۡفَ","فَعَلَ","رَبُّكَ","بِأَصۡحَٰبِ","ٱلۡفِيلِ"],"t":"Have you not considered how your Lord dealt with the People of the Elephant","l":"Alam Tara Kayfa Fa`ala Rabbuka Bi'ashabi Al-Fil","w":[["alam","Have not"],["tara","you seen"],["kayfa","how"],["faʿala","dealt"],["rabbuka","your Lord"],["bi-aṣḥābi","with (the) Companions"],["l-fīli","(of the) Elephant"]]},{"a":["أَلَمۡ","يَجۡعَلۡ","كَيۡدَهُمۡ","فِي","تَضۡلِيلٖ"],"t":"Did He not make their plan go wrong","l":"Alam Yaj`al Kaydahum Fi Tađlilin","w":[["alam","Did not"],["yajʿal","He make"],["kaydahum","their plan"],["fī","go"],["taḍlīlin","astray"]]},{"a":["وَأَرۡسَلَ","عَلَيۡهِمۡ","طَيۡرًا","أَبَابِيلَ"],"t":"He sent against them swarms of birds","l":"Wa 'Arsala `Alayhim Tayraan 'Ababila","w":[["wa-arsala","And He sent"],["ʿalayhim","against them"],["ṭayran","birds"],["abābīla","(in) flocks"]]},{"a":["تَرۡمِيهِم","بِحِجَارَةٖ","مِّن","سِجِّيلٖ"],"t":"Throwing at them rocks of baked clay","l":"Tarmihim Bihijaratin Min Sijjilin","w":[["tarmīhim","Striking them"],["biḥijāratin","with stones"],["min","of"],["sijjīlin","baked clay"]]},{"a":["فَجَعَلَهُمۡ","كَعَصۡفٖ","مَّأۡكُولِۭ"],"t":"Leaving them like chewed-up leaves","l":"Faja`alahum Ka`asfin Ma'kulin","w":[["fajaʿalahum","Then He made them"],["kaʿaṣfin","like straw"],["makūlin","eaten up"]]}]}