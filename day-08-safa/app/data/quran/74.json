{"v":[{"a":["يَـٰٓأَيُّهَا","ٱلۡمُدَّثِّرُ"],"t":"O you Enrobed one","l":"Ya 'Ayyuha Al-Muddaththiru","w":[["yāayyuhā","O you"],["l-mudathiru","who covers himself"]]},{"a":["قُمۡ","فَأَنذِرۡ"],"t":"Arise and warn","l":"Qum Fa'andhir","w":[["qum","Stand up"],["fa-andhir","and warn"]]},{"a":["وَرَبَّكَ","فَكَبِّرۡ"],"t":"And magnify your Lord","l":"Wa Rabbaka Fakabbir","w":[["warabbaka","And your Lord"],["fakabbir","magnify"]]},{"a":["وَثِيَابَكَ","فَطَهِّرۡ"],"t":"And purify your clothes","l":"Wa Thiyabaka Fatahhir","w":[["wathiyābaka","And your clothing"],["faṭahhir","purify"]]},{"a":["وَٱلرُّجۡزَ","فَٱهۡجُرۡ"],"t":"And abandon abominations","l":"Wa Ar-Rujza Fahjur","w":[["wal-ruj'za","And uncleanliness"],["fa-uh'jur","avoid"]]},{"a":["وَلَا","تَمۡنُن","تَسۡتَكۡثِرُ"],"t":"And show no favor seeking gain","l":"Wa La Tamnun Tastakthiru","w":[["walā","And (do) not"],["tamnun","confer favor"],["tastakthiru","(to) acquire more"]]},{"a":["وَلِرَبِّكَ","فَٱصۡبِرۡ"],"t":"And be constant for your Lord","l":"Wa Lirabbika Fasbir","w":[["walirabbika","And for your Lord"],["fa-iṣ'bir","be patient"]]},{"a":["فَإِذَا","نُقِرَ","فِي","ٱلنَّاقُورِ"],"t":"When the Trumpet is blown","l":"Fa'idha Nuqira Fi An-Naquri","w":[["fa-idhā","Then when"],["nuqira","is blown"],["fī","in"],["l-nāqūri","the trumpet"]]},{"a":["فَذَٰلِكَ","يَوۡمَئِذٖ","يَوۡمٌ","عَسِيرٌ"],"t":"That Day will be a difficult day","l":"Fadhalika Yawma'idhin Yawmun `Asirun","w":[["fadhālika","That"],["yawma-idhin","Day"],["yawmun","(will be) a Day"],["ʿasīrun","difficult"]]},{"a":["عَلَى","ٱلۡكَٰفِرِينَ","غَيۡرُ","يَسِيرٖ"],"t":"For the disbelievers—not easy","l":"Ala Al-Kafirina Ghayru Yasirin","w":[["ʿalā","For"],["l-kāfirīna","the disbelievers "],["ghayru","not"],["yasīrin","easy"]]},{"a":["ذَرۡنِي","وَمَنۡ","خَلَقۡتُ","وَحِيدٗا"],"t":"Leave Me to him whom I created alone","l":"Dharni Wa Man Khalaqtu Wahidaan","w":[["dharnī","Leave Me"],["waman","and whom"],["khalaqtu","I created"],["waḥīdan","alone"]]},{"a":["وَجَعَلۡ