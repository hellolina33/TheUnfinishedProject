{"v":[{"a":["هَلۡ","أَتَىٰكَ","حَدِيثُ","ٱلۡغَٰشِيَةِ"],"t":"Has there come to you the news of the overwhelming","l":"Hal 'Ataka Hadithu Al-Ghashiyahi","w":[["hal","Has"],["atāka","(there) come to you"],["ḥadīthu","(the) news"],["l-ghāshiyati","(of) the Overwhelming"]]},{"a":["وُجُوهٞ","يَوۡمَئِذٍ","خَٰشِعَةٌ"],"t":"Faces on that Day will be shamed","l":"Wujuhun Yawma'idhin Khashi`ahun","w":[["wujūhun","Faces"],["yawma-idhin","that Day"],["khāshiʿatun","(will be) humbled"]]},{"a":["عَامِلَةٞ","نَّاصِبَةٞ"],"t":"Laboring and exhausted","l":"Amilatun Nasibahun","w":[["ʿāmilatun","Laboring"],["nāṣibatun","exhausted"]]},{"a":["تَصۡلَىٰ","نَارًا","حَامِيَةٗ"],"t":"Roasting in a scorching Fire","l":"Tasla Naraan Hamiyahan","w":[["taṣlā","They will burn"],["nāran","(in) a Fire"],["ḥāmiyatan","intensely hot"]]},{"a":["تُسۡقَىٰ","مِنۡ","عَيۡنٍ","ءَانِيَةٖ"],"t":"Given to drink from a flaming spring","l":"Tusqa Min `Aynin 'Aniyahin","w":[["tus'qā","They will be given to drink"],["min","from"],["ʿaynin","a spring"],["āniyatin","boiling"]]},{"a":["لَّيۡسَ","لَهُمۡ","طَعَامٌ","إِلَّا","مِن","ضَرِيعٖ"],"t":"They will have no food except thorns","l":"Laysa Lahum Ta`amun 'Illa Min Đari`in","w":[["laysa","Not is"],["lahum","for them"],["ṭaʿāmun","food"],["illā","except"],["min","from"],["ḍarīʿin","a bitter thorny plant"]]},{"a":["لَّا","يُسۡمِنُ","وَلَا","يُغۡنِي","مِن","جُوعٖ"],"t":"That neither nourishes, nor satisfies hunger","l":"La Yusminu Wa La Yughni Min Ju`in","w":[["lā","Not"],["yus'minu","it nourishes"],["walā","and not"],["yugh'nī","it avails"],["min","from"],["jūʿin","hunger"]]},{"a":["وُجُوهٞ","يَوۡمَئِذٖ","نَّاعِمَةٞ"],"t":"Faces on that Day will be joyful","l":"Wujuhun Yawma'idhin Na`imahun","w":[["wujūhun","Faces"],["yawma-idhin","that Day"],["nāʿimatun","(will be) joyful"]]},{"a":["لِّسَعۡيِهَا","رَاضِيَةٞ"],"t":"Satisfied with their endeavor","l":"Lisa`yiha Rađiyahun","w":[["lisaʿyihā","With their effort"],["rāḍiyatun","satisfied"]]},{"a":["فِي","جَنَّةٍ","عَالِيَةٖ"],"t":"In a lofty Garden","l":"Fi Jannatin `Aliyahin","w":[["fī","In"],["jannatin","a garden"],["ʿāliyatin","elevated"]]},{"a":["لَّا","تَسۡمَعُ","فِيهَا","لَٰغِيَةٗ"],"t":"In it you will hear no nonsense","l":"La Tasma`u Fiha Laghiyahan","w":[["lā","Not"],["tasmaʿu","they will hear"],["fīhā","therein"],["lāghiyatan","vain talk"]]},{"a":["فِيهَا","عَيۡنٞ","جَارِيَةٞ"],"t":"In it is a flowing spring","l":"Fiha `Aynun Jariyahun","w":[["fīhā","Therein"],["ʿaynun","(will be) a spring"],["jāriyatun","flowing"]]},{"a":["فِيهَا","سُرُرٞ","مَّرۡفُوعَةٞ"],"t":"In it are raised beds","l":"Fiha Sururun Marfu`ahun","w":[["fīhā","Therein"],["sururun","(will be) thrones"],["marfūʿatun","raised high"]]},{"a":["وَأَكۡوَابٞ","مَّوۡضُوعَةٞ"],"t":"And cups set in place","l":"Wa 'Akwabun Mawđu`ahun","w":[["wa-akwābun","And cups"],["mawḍūʿatun","put in place"]]},{"a":["وَنَمَارِقُ","مَصۡفُوفَةٞ"],"t":"And cushions set in rows","l":"Wa Namariqu Masfufahun","w":[["wanamāriqu","And cushions"],["maṣfūfatun","lined up"]]},{"a":["وَزَرَابِيُّ","مَبۡثُوثَةٌ"],"t":"And carpets spread around","l":"Wa Zarabiyu Mabthuthahun","w":[["wazarābiyyu","And carpets"],["mabthūthatun","spread out"]]},{"a":["أَفَلَا","يَنظُرُونَ","إِلَى","ٱلۡإِبِلِ","كَيۡفَ","خُلِقَتۡ"],"t":"Do they not look at the camels—how they are created","l":"Afala Yanzuruna 'Ila Al-'Ibili Kayfa Khuliqat","w":[["afalā","Then do not"],["yanẓurūna","they look"],["ilā","towards"],["l-ibili","the camels"],["kayfa","how"],["khuliqat","they are created"]]},{"a":["وَإِلَى","ٱلسَّمَآءِ","كَيۡفَ","رُفِعَتۡ"],"t":"And at the sky—how it is raised","l":"Wa 'Ila As-Sama'i Kayfa Rufi`at","w":[["wa-ilā","And towards"],["l-samāi","the sky"],["kayfa","how"],["rufiʿat","it is raised"]]},{"a":["وَإِلَى","ٱلۡجِبَالِ","كَيۡفَ","نُصِبَتۡ"],"t":"And at the mountains—how they are installed","l":"Wa 'Ila Al-Jibali Kayfa Nusibat","w":[["wa-ilā","And towards"],["l-jibāli","the mountains"],["kayfa","how"],["nuṣibat","they are fixed"]]},{"a":["وَإِلَى","ٱلۡأَرۡضِ","كَيۡفَ","سُطِحَتۡ"],"t":"And at the earth—how it is spread out","l":"Wa 'Ila Al-'Arđi Kayfa Sutihat","w":[["wa-ilā","And towards"],["l-arḍi","the earth"],["kayfa","how"],["suṭiḥat","it is spread out"]]},{"a":["فَذَكِّرۡ","إِنَّمَآ","أَنتَ","مُذَكِّرٞ"],"t":"So remind. You are only a reminder","l":"Fadhakkir 'Innama 'Anta Mudhakkirun","w":[["fadhakkir","So remind"],["innamā","only"],["anta","you"],["mudhakkirun","(are) a reminder"]]},{"a":["لَّسۡتَ","عَلَيۡهِم","بِمُصَيۡطِرٍ"],"t":"You have no control over them","l":"Lasta `Alayhim Bimusaytirin","w":[["lasta","You are not"],["ʿalayhim","over them"],["bimuṣayṭirin","a controller"]]},{"a":["إِلَّا","مَن","تَوَلَّىٰ","وَكَفَرَ"],"t":"But whoever turns away and disbelieves","l":"Illa Man Tawalla Wa Kafara","w":[["illā","But"],["man","whoever"],["tawallā","turns away"],["wakafara","and disbelieves"]]},{"a":["فَيُعَذِّبُهُ","ٱللَّهُ","ٱلۡعَذَابَ","ٱلۡأَكۡبَرَ"],"t":"God will punish him with the greatest punishment","l":"Fayu`adhibuhu Allahu Al-`Adhaba Al-'Akbara","w":[["fayuʿadhibuhu","Then will punish him"],["l-lahu","Allah"],["l-ʿadhāba","(with) the punishment"],["l-akbara","greatest"]]},{"a":["إِنَّ","إِلَيۡنَآ","إِيَابَهُمۡ"],"t":"To Us is their return","l":"Inna 'Ilayna 'Iabahum","w":[["inna","Indeed"],["ilaynā","to Us"],["iyābahum","(will be) their return"]]},{"a":["ثُمَّ","إِنَّ","عَلَيۡنَا","حِسَابَهُم"],"t":"Then upon Us rests their reckoning","l":"Thumma 'Inna `Alayna Hisabahum","w":[["thumma","Then"],["inna","indeed"],["ʿalaynā","upon Us"],["ḥisābahum","(is) their account"]]}]}