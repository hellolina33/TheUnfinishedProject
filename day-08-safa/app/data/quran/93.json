{"v":[{"a":["وَٱلضُّحَىٰ"],"t":"By the morning light","l":"Wa Ađ-Đuha","w":[["wal-ḍuḥā","By the morning brightness"]]},{"a":["وَٱلَّيۡلِ","إِذَا","سَجَىٰ"],"t":"And the night as it settles","l":"Wa Al-Layli 'Idha Saja","w":[["wa-al-layli","And the night"],["idhā","when"],["sajā","it covers with darkness"]]},{"a":["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلَىٰ"],"t":"Your Lord did not abandon you, nor did He forget","l":"Ma Wadda`aka Rabbuka Wa Ma Qala","w":[["mā","Not"],["waddaʿaka","has forsaken you"],["rabbuka","your Lord"],["wamā","and not"],["qalā","He is displeased"]]},{"a":["وَلَلۡأٓخِرَةُ","خَيۡرٞ","لَّكَ","مِنَ","ٱلۡأُولَىٰ"],"t":"The Hereafter is better for you than the First","l":"Wa Lal'akhiratu Khayrun Laka Mina Al-'Ula","w":[["walalākhiratu","And surely the Hereafter"],["khayrun","(is) better"],["laka","for you"],["mina","than"],["l-ūlā","the first"]]},{"a":["وَلَسَوۡفَ","يُعۡطِيكَ","رَبُّكَ","فَتَرۡضَىٰٓ"],"t":"And your Lord will give you, and you will be satisfied","l":"Wa Lasawfa Yu`tika Rabbuka Fatarđa","w":[["walasawfa","And soon"],["yuʿ'ṭīka","will give you"],["rabbuka","your Lord"],["fatarḍā","then you will be satisfied"]]},{"a":["أَلَمۡ","يَجِدۡكَ","يَتِيمٗا","فَـَٔاوَىٰ"],"t":"Did He not find you orphaned, and sheltered you","l":"Alam Yajidka Yatimaan Fa'awa","w":[["alam","Did not"],["yajid'ka","He find you"],["yatīman","an orphan"],["faāwā","and give shelter"]]},{"a":["وَوَجَدَكَ","ضَآلّٗا","فَهَدَىٰ"],"t":"And found you wandering, and guided you","l":"Wa Wajadaka Đallaan Fahada","w":[["wawajadaka","And He found you"],["ḍāllan","lost"],["fahadā","so He guided"]]},{"a":["وَوَجَدَكَ","عَآئِلٗا","فَأَغۡنَىٰ"],"t":"And found you in need, and enriched you","l":"Wa Wajadaka `A'ilaan Fa'aghna","w":[["wawajadaka","And He found you"],["ʿāilan","in need"],["fa-aghnā","so He made self-sufficient"]]},{"a":["فَأَمَّا","ٱلۡيَتِيمَ","فَلَا","تَقۡهَرۡ"],"t":"Therefore, do not mistreat the orphan","l":"Fa'amma Al-Yatima Fala Taqhar","w":[["fa-ammā","So as for"],["l-yatīma","the orphan"],["falā","then (do) not"],["taqhar","oppress"]]},{"a":["وَأَمَّا","ٱلسَّآئِلَ","فَلَا","تَنۡهَرۡ"],"t":"Nor rebuff the seeker","l":"Wa 'Amma As-Sa'ila Fala Tanhar","w":[["wa-ammā","And as for"],["l-sāila","one who asks"],["falā","then (do) not"],["tanhar","repel"]]},{"a":["وَأَمَّا","بِنِعۡمَةِ","رَبِّكَ","فَحَدِّثۡ"],"t":"But proclaim the blessings of your Lord","l":"Wa 'Amma Bini`mati Rabbika Fahaddith","w":[["wa-ammā","But as for"],["biniʿ'mati","(the) Favor"],["rabbika","(of) your Lord"],["faḥaddith","narrate"]]}]}