{"v":[{"a":["أَرَءَيۡتَ","ٱلَّذِي","يُكَذِّبُ","بِٱلدِّينِ"],"t":"Have you considered him who denies the religion","l":"Ara'ayta Al-Ladhi Yukadhibu Bid-Dini","w":[["ara-ayta","Have you seen"],["alladhī","the one who"],["yukadhibu","denies"],["bil-dīni","the Judgment"]]},{"a":["فَذَٰلِكَ","ٱلَّذِي","يَدُعُّ","ٱلۡيَتِيمَ"],"t":"It is he who mistreats the orphan","l":"Fadhalika Al-Ladhi Yadu``u Al-Yatima","w":[["fadhālika","Then that"],["alladhī","(is) the one who"],["yaduʿʿu","repulses"],["l-yatīma","the orphan"]]},{"a":["وَلَا","يَحُضُّ","عَلَىٰ","طَعَامِ","ٱلۡمِسۡكِينِ"],"t":"And does not encourage the feeding of the poor","l":"Wa La Yahuđđu `Ala Ta`ami Al-Miskini","w":[["walā","And (does) not"],["yaḥuḍḍu","feel the urge"],["ʿalā","to"],["ṭaʿāmi","feed"],["l-mis'kīni","the poor"]]},{"a":["فَوَيۡلٞ","لِّلۡمُصَلِّينَ"],"t":"So woe to those who pray","l":"Fawaylun Lilmusallina","w":[["fawaylun","So woe"],["lil'muṣallīna","to those who pray"]]},{"a":["ٱلَّذِينَ","هُمۡ","عَن","صَلَاتِهِمۡ","سَاهُونَ"],"t":"Those who are heedless of their prayers","l":"Al-Ladhina Hum `An Salatihim Sahuna","w":[["alladhīna","Those who"],["hum","[they]"],["ʿan","about"],["ṣalātihim","their prayers"],["sāhūna","(are) neglectful"]]},{"a":["ٱلَّذِينَ","هُمۡ","يُرَآءُونَ"],"t":"Those who put on the appearance","l":"Al-Ladhina Hum Yura'una","w":[["alladhīna","Those who"],["hum","[they]"],["yurāūna","make show"]]},{"a":["وَيَمۡنَعُونَ","ٱلۡمَاعُونَ"],"t":"And withhold the assistance","l":"Wa Yamna`una Al-Ma`una","w":[["wayamnaʿūna","And they deny"],["l-māʿūna","[the] small kindnesses"]]}]}