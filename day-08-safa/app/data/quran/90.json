{"v":[{"a":["لَآ","أُقۡسِمُ","بِهَٰذَا","ٱلۡبَلَدِ"],"t":"I swear by this land","l":"La 'Uqsimu Bihadha Al-Baladi","w":[["lā","Nay"],["uq'simu","I swear"],["bihādhā","by this"],["l-baladi","city"]]},{"a":["وَأَنتَ","حِلُّۢ","بِهَٰذَا","ٱلۡبَلَدِ"],"t":"And you are a resident of this land","l":"Wa 'Anta Hillun Bihadha Al-Baladi","w":[["wa-anta","And you"],["ḥillun","(are) free (to dwell)"],["bihādhā","in this"],["l-baladi","city"]]},{"a":["وَوَالِدٖ","وَمَا","وَلَدَ"],"t":"And by a father and what he fathered","l":"Wa Walidin Wa Ma Walada","w":[["wawālidin","And the begetter"],["wamā","and what"],["walada","he begot"]]},{"a":["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِي","كَبَدٍ"],"t":"We created man in distress","l":"Laqad Khalaqna Al-'Insana Fi Kabadin","w":[["laqad","Certainly"],["khalaqnā","We have created"],["l-insāna","man"],["fī","(to be) in"],["kabadin","hardship"]]},{"a":["أَيَحۡسَبُ","أَن","لَّن","يَقۡدِرَ","عَلَيۡهِ","أَحَدٞ"],"t":"Does he think that no one has power over him","l":"Ayahsabu 'An Lan Yaqdira `Alayhi 'Ahadun","w":[["ayaḥsabu","Does he think"],["an","that"],["lan","not"],["yaqdira","has power"],["ʿalayhi","over him"],["aḥadun","anyone"]]},{"a":["يَقُولُ","أَهۡلَكۡتُ","مَالٗا","لُّبَدًا"],"t":"He says, “I have used up so much money.”","l":"Yaqulu 'Ahlaktu Malaan Lubadaan","w":[["yaqūlu","He will say"],["ahlaktu","I have squandered"],["mālan","wealth"],["lubadan","abundant"]]},{"a":["أَيَحۡسَبُ","أَن","لَّمۡ","يَرَهُۥٓ","أَحَدٌ"],"t":"Does he think that no one sees him","l":"Ayahsabu 'An Lam Yarahu 'Ahadun","w":[["ayaḥsabu","Does he think"],["an","that"],["lam","not"],["yarahu","sees him"],["aḥadun","anyone"]]},{"a":["أَلَمۡ","نَجۡعَل","لَّهُۥ","عَيۡنَيۡنِ"],"t":"Did We not give him two eyes","l":"Alam Naj`al Lahu `Aynayni","w":[["alam","Have not"],["najʿal","We made"],["lahu","for him"],["ʿaynayni","two eyes"]]},{"a":["وَلِسَانٗا","وَشَفَتَيۡنِ"],"t":"And a tongue, and two lips","l":"Wa Lisanaan Wa Shafatayni","w":[["walisānan","And a tongue"],["washafatayni","and two lips"]]},{"a":["وَهَدَيۡنَٰهُ","ٱلنَّجۡدَيۡنِ"],"t":"And We showed him the two ways","l":"Wa Hadaynahu An-Najdayni","w":[["wahadaynāhu","And shown him"],["l-najdayni","the two ways"]]},{"a":["فَلَا","ٱقۡتَحَمَ","ٱلۡعَقَبَةَ"],"t":"But he did not brave the ascent","l":"Fala Aqtahama Al-`Aqabaha","w":[["falā","But not"],["iq'taḥama","he has attempted"],["l-ʿaqabata","the steep path"]]},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡعَقَبَةُ"],"t":"And what will explain to you what the ascent is","l":"Wa Ma 'Adraka Ma Al-`Aqabahu","w":[["wamā","And what"],["adrāka","can make you know"],["mā","what"],["l-ʿaqabatu","the steep path (is)"]]},{"a":["فَكُّ","رَقَبَةٍ"],"t":"The freeing of a slave","l":"Fakku Raqabahin","w":[["fakku","(It is) freeing"],["raqabatin","a neck"]]},{"a":["أَوۡ","إِطۡعَٰمٞ","فِي","يَوۡمٖ","ذِي","مَسۡغَبَةٖ"],"t":"Or the feeding on a day of hunger","l":"Aw 'It`amun Fi Yawmin Dhi Masghabahin","w":[["aw","Or"],["iṭ'ʿāmun","feeding"],["fī","in"],["yawmin","a day"],["dhī","of"],["masghabatin","severe hunger"]]},{"a":["يَتِيمٗا","ذَا","مَقۡرَبَةٍ"],"t":"An orphan near of kin","l":"Yatimaan Dha Maqrabahin","w":[["yatīman","An orphan"],["dhā","of"],["maqrabatin","near relationship"]]},{"a":["أَوۡ","مِسۡكِينٗا","ذَا","مَتۡرَبَةٖ"],"t":"Or a destitute in the dust","l":"Aw Miskinaan Dha Matrabahin","w":[["aw","Or"],["mis'kīnan","a needy person"],["dhā","in"],["matrabatin","misery"]]},{"a":["ثُمَّ","كَانَ","مِنَ","ٱلَّذِينَ","ءَامَنُواْ","وَتَوَاصَوۡاْ","بِٱلصَّبۡرِ","وَتَوَاصَوۡاْ","بِٱلۡمَرۡحَمَةِ"],"t":"Then he becomes of those who believe, and advise one another to patience, and advise one another to kindness","l":"Thumma Kana Mina Al-Ladhina 'Amanu Wa Tawasaw Bis-Sabri Wa Tawasaw Bil-Marhamahi","w":[["thumma","Then"],["kāna","he is"],["mina","of"],["alladhīna","those who"],["āmanū","believe"],["watawāṣaw","and enjoin (each other)"],["bil-ṣabri","to patience"],["watawāṣaw","and enjoin (each other)"],["bil-marḥamati","to compassion"]]},{"a":["أُوْلَـٰٓئِكَ","أَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ"],"t":"These are the people of happiness","l":"Ula'ika 'Ashabu Al-Maymanahi","w":[["ulāika","Those"],["aṣḥābu","(are the) companions"],["l-maymanati","(of) the right (hand)"]]},{"a":["وَٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِنَا","هُمۡ","أَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ"],"t":"But as for those who defy Our revelations—these are the people of misery","l":"Wa Al-Ladhina Kafaru Bi'ayatina Hum 'Ashabu Al-Mash'amahi","w":[["wa-alladhīna","But those who"],["kafarū","disbelieve"],["biāyātinā","in Our Verses"],["hum","they"],["aṣḥābu","(are the) companions"],["l-mashamati","(of) the left (hand)"]]},{"a":["عَلَيۡهِمۡ","نَارٞ","مُّؤۡصَدَةُۢ"],"t":"Upon them is a padlocked Fire","l":"Alayhim Narun Mu'usadahun","w":[["ʿalayhim","Over them"],["nārun","(will be the) Fire"],["mu'ṣadatun","closed in"]]}]}